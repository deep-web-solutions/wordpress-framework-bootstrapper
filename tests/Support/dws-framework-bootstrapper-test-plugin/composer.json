{
  "name": "deep-web-solutions/wp-framework-bootstrapper-test-plugin",
  "type": "wordpress-plugin",

  "repositories": [
    {
      "type": "path",
      "url": "../../../",
      "options": {
        "symlink": true
      }
    }
  ],
  "require": {
    "deep-web-solutions/wp-framework-bootstrapper": "@dev"
  },
  "scripts": {
    "generate-autoloader": "@composer dump-autoload --ignore-platform-reqs -o",
    "packages-update": [
      "@composer clear-cache",
      "@composer update --prefer-stable --ignore-platform-reqs --no-interaction"
    ]
  }
}
