{
  "name": "deep-web-solutions/wp-framework-bootstrapper-test-plugin",
  "type": "wordpress-plugin",

  "repositories": [
    {
      "type": "path",
      "url": "../dws-framework-bootstrapper",
      "options": {
        "symlink": true
      }
    },
    {
      "packagist.org": false
    }
  ],
  "require": {
    "deep-web-solutions/wp-framework-bootstrapper": "*"
  },
  "minimum-stability": "dev",
  "prefer-stable": false,

  "scripts": {
    "packages-update": [
      "@composer clear-cache",
      "@composer update --ignore-platform-reqs --no-interaction"
    ]
  }
}
